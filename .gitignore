# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/

# Environment
# Ignore every .env variant (.env.docker, .env.preprod, ...) so a real secrets
# file can never be committed by accident. The two examples are opt-in.
.env
.env.*
!.env.example
!.env.preprod.example

# Local Docker smoke test — stand-in for the Angular bundle
www-local/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code per-developer settings. `.claude/settings.json` is the shared
# file if we ever want one; `settings.local.json` is personal and holds
# machine-specific paths and permission grants.
.claude/settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/

# Distribution
dist/
build/
*.egg-info/

# Database
*.db

# Logs
*.log
nul
