# ---------------------------------------------------------------------------
# Pre-production environment file.
#
# On the server this lives at /opt/dental/.env  (chmod 600, never committed).
# Copy this file, fill in real values, and keep it OFF git.
#
# Docker Compose reads it twice:
#   --env-file  -> substitutes ${API_HOST} / ${ADMIN_HOST} into the Caddyfile
#   env_file:   -> injects the rest as real env vars into the api container
#
# Real environment variables take priority over the app's .env file, so this
# never interferes with your local .env.
# ---------------------------------------------------------------------------

# Which environment this instance reports at GET /health
APP_ENV=preprod

# --- Public hostnames -------------------------------------------------------
# These are the live pre-prod values, not placeholders — both are A records on
# smiletimeclinic.rs (Loopia) pointing at the pre-prod server. Point DNS at the
# box BEFORE bringing Caddy up on a new hostname: the Let's Encrypt HTTP-01
# challenge resolves the name, so starting early just burns attempts.
#
# On a box with no DNS, sslip.io resolves the IPv4 encoded in the hostname:
# 5.161.42.7 -> api.5-161-42-7.sslip.io
API_HOST=preprod.api.smiletimeclinic.rs
ADMIN_HOST=preprod.admin.smiletimeclinic.rs

# Email address Let's Encrypt uses for expiry notices
ACME_EMAIL=you@example.com

# --- Database ---------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the pooler host. database.py adds sslmode=require for non-localhost.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# --- Auth -------------------------------------------------------------------
# GENERATE A FRESH ONE — do not reuse the value from .env.example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-GENERATE-A-REAL-SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------------
# Must be set explicitly. If omitted, config.py falls back to http://localhost:4200
# and the deployed frontend's requests get blocked. Comma-separated; must match
# ADMIN_HOST exactly, scheme included and no trailing slash.
ALLOWED_ORIGINS=https://preprod.admin.smiletimeclinic.rs

# --- Frontend ---------------------------------------------------------------
# Base for invite / set-password links. No trailing slash.
FRONTEND_URL=https://preprod.admin.smiletimeclinic.rs

# --- Email (Resend) ---------------------------------------------------------
# smiletimeclinic.rs is verified in Resend (DKIM plus the two SPF CNAMEs at
# Loopia, DMARC on `_dmarc`), so invites send from the domain itself. Two things
# to keep in mind:
#   - The API key must belong to the same Resend account the domain is verified
#     on. A key from another account fails with "domain is not verified" even
#     though DNS is correct, and users.py swallows the error — creating a user
#     still returns 201, so a broken key looks like it worked. Check the send in
#     Resend -> Logs, or `docker logs app-api-1 | grep -i invite`.
#   - Use the `Name <addr>` form. No deploy script sources this file (compose
#     parses it), so the spaces and angle brackets are safe unquoted.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Smile Time Clinic <noreply@smiletimeclinic.rs>

# --- Supabase Storage (patient documents) -----------------------------------
# service_role key, NOT the anon key. No trailing slash on the URL.
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=patient-documents
