# local | preprod | production. Reported by GET /health, and it decides how
# strictly SECRET_KEY is checked at startup.
APP_ENV=local

DATABASE_URL=postgresql://postgres:password@localhost:5432/dental_ordination

# Fine as-is for local work. Anywhere APP_ENV is not `local`, the app refuses to
# boot while this is still the built-in default — it is public in this
# repository, so it would let anyone forge an admin token. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins. Deployed environments must set this
# explicitly; see .env.preprod.example.
ALLOWED_ORIGINS=http://localhost:4200

# Frontend URL for invite/password-reset links
FRONTEND_URL=http://localhost:4200

# Email — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Supabase Storage (for patient document uploads)
# Get these from: Supabase dashboard -> Project Settings -> API
# Use the service_role key (NOT the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=patient-documents
